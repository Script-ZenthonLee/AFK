--// Anti AFK com logo personalizado + notificação
wait(0.5)

-- Criando GUI
local gui = Instance.new("ScreenGui")
gui.Parent = game.CoreGui
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Bolinha com logo
local bolinha = Instance.new("ImageButton")
bolinha.Parent = gui
bolinha.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- sempre preta
bolinha.Image = "https://www.roblox.com/Thumbs/Asset.ashx?width=420&height=420&assetId=79956122844756" -- 🌀 teu logo
bolinha.Size = UDim2.new(0, 60, 0, 60)
bolinha.Position = UDim2.new(0.8, 0, 0.2, 0)
bolinha.Active = true
bolinha.Draggable = true
bolinha.AutoButtonColor = false
bolinha.BorderSizePixel = 0
bolinha.ScaleType = Enum.ScaleType.Fit -- garante que a imagem fique centralizada

-- Deixa a bolinha redonda
local corner = Instance.new("UICorner", bolinha)
corner.CornerRadius = UDim.new(1, 0)

-- Status e serviços
local ativo = false
local VirtualUser = game:service("VirtualUser")

-- Função de notificação
local function notify(msg)
	game:GetService("StarterGui"):SetCore("SendNotification", {
		Title = "Anti-AFK",
		Text = msg,
		Duration = 4
	})
end

-- Clique para ativar/desativar
bolinha.MouseButton1Click:Connect(function()
	ativo = not ativo
	if ativo then
		notify("Anti-AFK Enabled ✅")
	else
		notify("Anti-AFK Disabled ❌")
	end
end)

-- Loop de anti-AFK
game.Players.LocalPlayer.Idled:Connect(function()
	if ativo then
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end
end)
