  .unsaved-bar { left: 12px; right: 12px; transform: translateY(30px); width: auto; }
  .unsaved-bar.show { transform: translateY(0px); }
}

@media (max-width: 560px) {
  body:has(.unsaved-bar.show) .toast-wrap { bottom: 84px; }
}

.notif-wrap { position: relative; }

.notif-badge { position: absolute; top: -4px; right: -4px; min-width: 16px; height: 16px; padding: 0px 4px; border-radius: 100px; background: var(--accent); color: rgb(255, 255, 255); font-size: 0.62rem; font-weight: 700; display: grid; place-items: center; border: 2px solid var(--bg); }

.notif-pop { position: absolute; top: calc(100% + 10px); right: 0px; left: auto; width: 340px; max-width: calc(-16px + 100vw); background: rgb(14, 14, 14); backdrop-filter: none; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; box-shadow: rgba(255, 255, 255, 0.05) 0px 1px 0px inset, rgba(0, 0, 0, 0.85) 0px 30px 70px -28px; opacity: 0; visibility: hidden; transform: translateY(6px) translateX(var(--pop-x,0px)); transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease), visibility var(--dur-2); z-index: 60; overflow: hidden; }

.notif-wrap.open .notif-pop { opacity: 1; visibility: visible; transform: translateX(var(--pop-x,0px)); }

.notif-head { padding: 14px 16px; font-size: 0.86rem; font-weight: 600; color: var(--text); border-bottom: 1px solid var(--line-soft); }

.notif-empty { padding: 26px 16px; text-align: center; color: var(--text-3); font-size: 0.86rem; }

.notif-list { max-height: 400px; overflow-y: auto; }

.notif-item { display: flex; gap: 11px; padding: 12px 16px; border-bottom: 1px solid var(--line-soft); text-decoration: none; transition: background var(--dur-1) var(--ease); }

.notif-item:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.notif-item:hover { background: var(--hover); }

.notif-item.unread { background: rgba(var(--accent-rgb),0.05); }

.notif-dot { width: 7px; height: 7px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; background: var(--accent); }

.notif-dot.bad { background: var(--bad); }

.notif-dot.warn { background: var(--warn); }

.notif-body { min-width: 0px; display: flex; flex-direction: column; gap: 2px; }

.notif-title { font-size: 0.86rem; font-weight: 500; color: var(--text); }

.notif-text { display: flex; flex-direction: column; gap: 5px; margin-top: 3px; font-size: 0.8rem; color: var(--text-3); line-height: 1.4; overflow-wrap: anywhere; }

.notif-line { display: block; }

.notif-gap { height: 2px; }

.notif-point { display: grid; grid-template-columns: 16px minmax(0px, 1fr); gap: 6px; align-items: start; padding: 6px 8px; border: 1px solid var(--line-soft); border-radius: 7px; background: rgba(255, 255, 255, 0.02); }

.notif-mark { font-family: var(--mono); font-weight: 700; text-align: center; }

.notif-point.add { color: var(--good); background: rgba(var(--good-rgb),0.06); border-color: rgba(var(--good-rgb),0.14); }

.notif-point.remove { color: var(--bad); background: rgba(var(--bad-rgb),0.06); border-color: rgba(var(--bad-rgb),0.14); }

.notif-point.change { color: var(--warn); background: rgba(var(--warn-rgb),0.06); border-color: rgba(var(--warn-rgb),0.14); }

.notif-point.point .notif-mark { color: var(--accent); }

.notif-time { font-size: 0.72rem; color: var(--text-4); margin-top: 2px; }

.notif-seeall { display: block; width: 100%; padding: 12px 16px; border-right-width: medium; border-bottom-width: medium; border-left-width: medium; border-right-style: none; border-bottom-style: none; border-left-style: none; border-right-color: currentcolor; border-bottom-color: currentcolor; border-left-color: currentcolor; border-image: none; border-top: 1px solid var(--line-soft); background: transparent; color: var(--accent); font-size: 0.82rem; font-weight: 600; text-align: center; cursor: pointer; transition: background var(--dur-1) var(--ease); }

.notif-seeall:hover { background: var(--hover); }

.modal-notifs { max-width: 520px; }

.notif-all-body { flex: 1 1 auto; min-height: 0px; overflow-y: auto; }

.notif-all-body .notif-item { padding: 13px 20px; }

.notif-all-body .notif-empty { padding: 44px 20px; }

.obs-tip { position: fixed; z-index: 9500; pointer-events: none; max-width: 250px; width: max-content; background: var(--popover); color: var(--text); border: 1px solid var(--line); border-radius: 8px; padding: 5px 9px; font-size: 0.75rem; font-weight: 500; line-height: 1.35; letter-spacing: -0.004em; box-shadow: rgba(0, 0, 0, 0.72) 0px 10px 30px -10px, rgba(0, 0, 0, 0.5) 0px 2px 8px -3px; opacity: 0; transform: translateY(3px) scale(0.97); transition: opacity .13s var(--ease), transform .13s var(--ease); }

.obs-tip.tip-bottom { transform: translateY(-3px) scale(0.97); }

.obs-tip.show { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .obs-tip, .obs-tip.tip-bottom { transform: none; }
  .obs-tip { transition: opacity 0.1s linear; }
}
