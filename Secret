-- Anti-Idle & Anti-AFK Connection
local connection
connection = localPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Anti-Kick on Server (Metamethod Hook)
local mt = getrawmetatable(game)
local backup = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    if getnamecallmethod() == "Kick" and self == localPlayer then
        return
    end
    return backup(self, ...)
end)

setreadonly(mt, true)

-- Timer Logic
local startTime = tick()

RunService.RenderStepped:Connect(function()
    local elapsedTime = math.floor(tick() - startTime)
    local hours = math.floor(elapsedTime / 3600)
    local minutes = math.floor((elapsedTime % 3600) / 60)
    local seconds = elapsedTime % 60
    
    timerLabel.Text = string.format("%02d:%02d:%02d", hours, minutes, seconds)
end)

-- Send Notification with Custom rbxassetid
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Anti-AFK & Anti-KICK Activated",
    Text = "Successfully Executed Anti-AFK & Anti-KICK!",
    Icon = "https://www.roblox.com/Thumbs/Asset.ashx?width=420&height=420&assetId=113281701497572",
    Duration = 5
})

-- Repeating Fade In and Fade Out Animation Loop
task.spawn(function()
    local fadeInInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeOutInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    while screenGui.Parent do
        -- Fade In Text
        TweenService:Create(titleLabel, fadeInInfo, {TextTransparency = 0}):Play()
        TweenService:Create(timerLabel, fadeInInfo, {TextTransparency = 0}):Play()

        -- Stay visible for 2.8 seconds
        task.wait(2.8)

        -- Fade Out Text
        TweenService:Create(titleLabel, fadeOutInfo, {TextTransparency = 1}):Play()
        TweenService:Create(timerLabel, fadeOutInfo, {TextTransparency = 1}):Play()

        -- Wait before fading back in
        task.wait(2.3)
    end
end)
